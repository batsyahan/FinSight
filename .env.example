# Which LLM backend the agents use: mock | anthropic | openai
#   mock      -> no API key needed, deterministic offline agents (good for demos/tests)
#   anthropic -> Claude via the Anthropic Messages API
#   openai    -> any OpenAI-compatible endpoint (OpenAI, Groq, Ollama, OpenRouter, Gemini's OpenAI endpoint)
FINSIGHT_LLM=mock

# Model name for the chosen backend (check your provider's docs for current names)
FINSIGHT_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI-compatible
OPENAI_API_KEY=
# e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Market data: sample | yfinance
FINSIGHT_DATA=sample

# Max Writer <-> Critic revision rounds
FINSIGHT_MAX_REVISIONS=2

# Reasoning models (e.g. openai/gpt-oss-*) think before answering. FinSight sets
# reasoning_effort=low and a 3000-token output floor for them automatically.
FINSIGHT_REASONING_EFFORT=
FINSIGHT_MAX_TOKENS=
